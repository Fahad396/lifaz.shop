# LIFAZ Atelier — Environment Configuration

# Server & App Environment
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin Master Security & Passkey (Required for /admin access)
ADMIN_PASSKEY="lifaz_atelier_passkey_2026"
ADMIN_SECRET_KEY="lifaz_atelier_passkey_2026"

# Database Configuration (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./data/dev.db"

# NextAuth / Session Secret (32+ characters)
NEXTAUTH_SECRET="lifaz-atelier-secure-random-secret-key-32-chars-min"
NEXTAUTH_URL="http://localhost:3000"
