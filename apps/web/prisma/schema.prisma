// Prisma schema for LIFAZ Luxury E-Commerce Architecture
// Production VPS: Native PostgreSQL on localhost:5432 (0 Cloud Dependencies)
// Local Dev / Offline: SQLite or Native Local Engine

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  description     String
  price           Float
  compareAtPrice  Float?
  category        String
  drop            String
  dropNumber      Int      @default(1)
  color           String
  colorHex        String   @default("#111111")
  details         String[]
  fabrication     String[]
  images          String[]
  sizeChartImage  String?
  sizeChartNotes  String?
  rating          Float    @default(5.0)
  reviewCount     Int      @default(0)
  featured        Boolean  @default(false)
  badge           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  variants        ProductVariant[]

  @@index([category])
  @@index([drop])
  @@index([slug])
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  size      String
  color     String
  sku       String   @unique
  inventory Int      @default(10)
  inStock   Boolean  @default(true)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sku])
}

model Drop {
  id             String   @id @default(uuid())
  dropNumber     Int      @unique
  title          String
  name           String
  subtitle       String?
  description    String
  heroImage      String
  lookbookImages String[]
  status         String   @default("Upcoming") // "Active" | "Upcoming" | "Archived"
  releaseDate    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
}

model Order {
  id               String   @id @default(uuid())
  orderNumber      String   @unique
  userId           String?
  customer         String
  email            String
  phone            String
  division         String
  area             String
  address          String
  items            String   // Summary line
  subtotal         Float
  shippingCost     Float
  total            Float
  paymentType      String?  // "advance_delivery_cod" | "full_advance" | "full_cod"
  advancePaid      Float?   @default(0)
  dueAmount        Float?   @default(0)
  status           String   @default("Order Confirmed") // "Order Confirmed" | "In Atelier Prep" | "Dispatched via Courier" | "Delivered" | "Cancelled"
  paymentMethod    String   // e.g. "bKash Mobile Banking"
  paymentMethodId  String?
  paymentStatus    String?  @default("Pending Verification") // "Pending Verification" | "Payment Verified" | "COD Due" | "Refunded"
  bkashTrxId       String?
  paymentReference String?
  date             String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([phone])
}

model PaymentMethodConfig {
  id            String   @id @default(uuid())
  name          String
  type          String   // "cod" | "mfs" | "card" | "bank" | "custom"
  provider      String   // "cod" | "bkash" | "nagad" | "rocket" | "upay" | "card" | "bank" | "custom"
  accountNumber String?
  accountType   String?  // "Personal" | "Merchant" | "Agent"
  instructions  String?
  requiresTrxId Boolean  @default(false)
  isActive      Boolean  @default(true)
  displayOrder  Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([provider])
  @@index([isActive])
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String
  password  String
  division  String?
  area      String?
  address   String?
  vipTier   String?  @default("VIP MEMBER")
  role      String   @default("CUSTOMER") // "ADMIN" | "CUSTOMER"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]

  @@index([email])
  @@index([phone])
}

model Inquiry {
  id           String   @id @default(uuid())
  ticketNumber String   @unique
  name         String
  email        String
  phone        String?
  subject      String
  message      String
  orderNumber  String?
  status       String   @default("Pending") // "Pending" | "In Review" | "Resolved"
  createdAt    DateTime @default(now())
}

model Subscriber {
  id           String   @id @default(uuid())
  email        String   @unique
  subscribedAt DateTime @default(now())

  @@index([email])
}

model SystemSettings {
  id        String   @id @default("singleton")
  heroJson  String   // JSON string of HeroSettings
  mosaicJson String  // JSON string of MosaicSettings
  updatedAt DateTime @updatedAt
}
